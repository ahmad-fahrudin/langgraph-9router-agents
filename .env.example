# ==========================================
# Konfigurasi 9Router & LangGraph
# ==========================================

# Base URL 9Router (secara default lokal adalah http://localhost:20128/v1)
ROUTER_BASE_URL=http://localhost:20128/v1

# API Key dari 9Router Dashboard (Menu API Keys)
ROUTER_API_KEY=sk-your-9router-api-key

# Nama Combo yang sudah dibuat di 9Router (Menu Combos)
# Contoh: AntiGravityModel, FreeKiroAI, atau nama combo buatan Anda sendiri
ROUTER_MODEL=my_combo_name

# Parameter model
ROUTER_TEMPERATURE=0.7
