# Konfigurasi 9Router Lokal
ROUTER_BASE_URL=http://localhost:20128/v1
ROUTER_API_KEY=your-9router-api-key

# Default Fallback Model
ROUTER_MODEL=AntiGravityModel
ROUTER_TEMPERATURE=0.7

# Model Konfigurasi Sesuai Kepintaran Domain Masing-masing (Ultra Fast & Smart)
# Coder: FreeGptCODEX (GPT-6 Luna - ultra cepat, spesialis software engineering & code generation)
ROUTER_CODER_MODEL=FreeGptCODEX
ROUTER_CODER_TEMPERATURE=0.1

# Researcher: FreeKiroAI (DeepSeek 3.2 / Qwen3 Coder Next - spesialis deep reasoning & riset mendalam)
ROUTER_RESEARCHER_MODEL=FreeKiroAI
ROUTER_RESEARCHER_TEMPERATURE=0.3

# General Assistant: AntiGravityModel (Gemini 3.8 Flash High - 1M context, respons cepat & serbaguna)
ROUTER_GENERAL_MODEL=AntiGravityModel
ROUTER_GENERAL_TEMPERATURE=0.5

# Team Orchestrator / Supervisor: Berpikir Bareng-bareng
ROUTER_TEAM_MODEL=AntiGravityModel
ROUTER_TEAM_TEMPERATURE=0.1

# Default Streaming
ROUTER_STREAM=true
